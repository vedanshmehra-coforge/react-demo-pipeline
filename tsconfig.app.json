{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "ignoreDeprecations": "6.0",

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*":         ["./src/*"],
      "@core/*":     ["./src/core/*"],
      "@shared/*":   ["./src/shared/*"],
      "@domains/*":  ["./src/domains/*"],
      "@store/*":    ["./src/store/*"],
      "@layouts/*":  ["./src/layouts/*"],
      "@pages/*":    ["./src/pages/*"],
      "@routes/*":   ["./src/routes/*"],
      "@config/*":   ["./src/config/*"],
      "@assets/*":   ["./src/assets/*"]
    }
  },
  "include": ["src"]
}
